# Solo se versionan LineVul-main/, AMPLE-main/ y los documentos de la raiz.
# Todo lo demas de esta carpeta (otros modelos, datasets, entornos virtuales,
# el clon de dgl, zips, configuracion local) queda fuera.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/PROGRESS.md
!/LineVul-main/
!/AMPLE-main/
!/patches/
!/environment/

# Dentro de LineVul-main/ y AMPLE-main/: nada pesado ni regenerable.
# GitHub rechaza archivos de mas de 100 MB; esto es solo codigo, docs y logs.
__pycache__/
*.pyc
.DS_Store
.hf_cache/

# Datasets y datos generados
*.csv
/LineVul-main/data/
/LineVul-main/cppcheck/data/
/AMPLE-main/devign_dataset*/
/AMPLE-main/attention_weight/
/AMPLE-main/tmp/

# Pesos de modelos, checkpoints, binarios y comprimidos
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.zip
*.tar
*.tar.gz
/LineVul-main/linevul/saved_models/
/LineVul-main/linevul/bpe_tokenizer/
/LineVul-main/linevul/word_level_tokenizer/
/AMPLE-main/word2vec_model/
/AMPLE-main/joern_bin/

# PDFs ajenos (presentaciones, papers); se deja pasar la curva de resultados propia
*.pdf
!/LineVul-main/linevul/test_precision_recall_12heads_linevul_model.bin.pdf
