diff --git a/graphbolt/CMakeLists.txt b/graphbolt/CMakeLists.txt
index 8fdcbd50..7b50a593 100644
--- a/graphbolt/CMakeLists.txt
+++ b/graphbolt/CMakeLists.txt
@@ -64,7 +64,14 @@ if(USE_CUDA)
   endif()
   set(CMAKE_CUDA_ARCHITECTURES_FILTERED ${CMAKE_CUDA_ARCHITECTURES})
   # CUDA extension supports only sm_70 and up (Volta+).
-  list(FILTER CMAKE_CUDA_ARCHITECTURES_FILTERED EXCLUDE REGEX "[2-6][0-9]")
+  # Fix: el regex original "[2-6][0-9]" hace match parcial (no full-match) en
+  # CMake list(FILTER ... REGEX), asi que "120" (Blackwell, 3 digitos)
+  # matcheaba por la substring "20" y se filtraba igual que sm_20-sm_69,
+  # dejando la lista vacia y cayendo al fallback hardcoded "70" (Volta) que
+  # nvcc de CUDA 13.2 ya ni siquiera soporta (deprecado). Se ancla el regex
+  # a inicio/fin de string para que solo excluya arquitecturas reales de 2
+  # digitos en el rango 20-69, no substrings de arquitecturas de 3 digitos.
+  list(FILTER CMAKE_CUDA_ARCHITECTURES_FILTERED EXCLUDE REGEX "^[2-6][0-9]$")
   list(LENGTH CMAKE_CUDA_ARCHITECTURES_FILTERED CMAKE_CUDA_ARCHITECTURES_FILTERED_LEN)
   if(CMAKE_CUDA_ARCHITECTURES_FILTERED_LEN EQUAL 0)
     # Build the CUDA extension at least build for Volta.
diff --git a/graphbolt/build.sh b/graphbolt/build.sh
index 7c71f755..21c17157 100755
--- a/graphbolt/build.sh
+++ b/graphbolt/build.sh
@@ -31,9 +31,18 @@ fi
 CMAKE_FLAGS="-DCUDA_TOOLKIT_ROOT_DIR=$CUDA_TOOLKIT_ROOT_DIR -DUSE_CUDA=$USE_CUDA -DTORCH_CUDA_ARCH_LIST=$TORCH_CUDA_ARCH_LIST"
 echo "graphbolt cmake flags: $CMAKE_FLAGS"
 
+# Fix: "make -j" sin numero usa todos los cores sin limite de RAM por job,
+# y este build.sh corre como script externo invocado por add_custom_target()
+# en el CMakeLists.txt padre - no hereda el -j del make de afuera (es un
+# proceso bash separado). En maquinas con RAM ajustada, varias unidades de
+# compilacion CUDA/CCCL pesadas en paralelo agotan la RAM y matan cc1plus a
+# mitad de compilacion. GRAPHBOLT_MAKE_JOBS permite acotar el paralelismo
+# desde afuera (default: todos los cores, comportamiento original).
+MAKE_JOBS="${GRAPHBOLT_MAKE_JOBS:-}"
+
 if [ $# -eq 0 ]; then
   $CMAKE_COMMAND $CMAKE_FLAGS ..
-  make -j
+  make -j $MAKE_JOBS
   cp -v $CPSOURCE $BINDIR/graphbolt
 else
   for PYTHON_INTERP in $@; do
@@ -41,7 +50,7 @@ else
     mkdir -p $TORCH_VER
     cd $TORCH_VER
     $CMAKE_COMMAND $CMAKE_FLAGS -DPYTHON_INTERP=$PYTHON_INTERP ../..
-    make -j
+    make -j $MAKE_JOBS
     cp -v $CPSOURCE $BINDIR/graphbolt
     cd ..
   done
